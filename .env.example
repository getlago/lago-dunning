# Read invoices and payments from your configured accounts.
APP_MODE=connected
ALLOW_LIVE_ACTIONS=false
PORT=4320
APP_TIMEZONE=Europe/Paris
# Connected workspace database; keep test fixtures in separate databases.
# DATABASE_PATH=./data/connected.db
# Local access opens this single-company app directly on this computer.
APP_ACCESS_MODE=local
# Optional key access: set APP_ACCESS_MODE=key and use long random keys.
ADMIN_KEYS=
# Optional ordinary member keys; cannot manage Qonto settings or sandbox tests.
WORKSPACE_KEYS=
# Optional reverse-proxy exposure. The listener stays on 127.0.0.1; list the exact https
# origin(s) browsers will use and allow forwarded headers from the proxy on this machine.
# Put authentication in front of the proxy: local access mode has no login of its own.
# PUBLIC_ORIGIN=https://receivables.example.com
# TRUST_PROXY=true

# Existing PydanticAI stack: Bedrock or Anthropic.
# These model IDs are initial defaults. Agent settings in the app saves a checked
# selection for this workspace, which takes precedence without editing this file.
MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_DEFAULT_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5
ANTHROPIC_API_KEY=
# PYTHON_PATH=/absolute/path/to/.venv/bin/python

LAGO_API_URL=https://api.getlago.com/api/v1
LAGO_API_KEY=
# Sources that must be checked before any reminder. Add qonto or stripe once connected.
REQUIRED_PAYMENT_SOURCES=lago
MAX_SOURCE_AGE_MINUTES=15

QONTO_ACCESS_TOKEN=
QONTO_API_URL=https://thirdparty.qonto.com/v2
# For sandbox: https://thirdparty-sandbox.staging.qonto.co/v2 and QONTO_STAGING_TOKEN.
# A bearer token uses the direct connector when no connection mode is set.
# Set oauth explicitly to use a saved OAuth connection; no credential fallback.
# QONTO_CONNECTION_MODE=api_key
# Optional settings for the retained OAuth backend (no setup form in the UI).
QONTO_CLIENT_ID=
QONTO_CLIENT_SECRET=
# Optional: otherwise the first Qonto consent pins the organisation automatically.
QONTO_ORGANIZATION_ID=
QONTO_ENVIRONMENT=production
QONTO_REDIRECT_URI=http://localhost:4320/oauth/qonto/callback
# Optional server-managed key. The administrator form generates a key automatically.
QONTO_TOKEN_ENCRYPTION_KEY=
QONTO_SANDBOX_CLIENT_ID=
QONTO_SANDBOX_CLIENT_SECRET=
QONTO_SANDBOX_STAGING_TOKEN=
QONTO_BANK_ACCOUNT_IDS=
QONTO_STAGING_TOKEN=
STRIPE_API_KEY=
STRIPE_CUSTOMER_MAP=

# Untested connectors: implemented, but not yet validated against live accounts.
# Additional provider settings are supported by src/cash/config.js.
MERCURY_API_TOKEN=
BREX_API_TOKEN=
BREX_CASH_ACCOUNT_IDS=
RAMP_API_TOKEN=
RAMP_TREASURY_ACCOUNT_ID=
RAMP_RECEIPTS_PATH=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_ACCOUNT_MAP=
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
QUICKBOOKS_ACCESS_TOKEN=
QUICKBOOKS_REALM_ID=
BUSINESS_CENTRAL_ACCESS_TOKEN=
BUSINESS_CENTRAL_COMPANY_ID=
BUSINESS_CENTRAL_PAYMENT_JOURNAL_ID=
NETSUITE_ACCESS_TOKEN=
NETSUITE_ACCOUNT_ID=
NETSUITE_API_URL=
SAP_ACCESS_TOKEN=
SAP_SYSTEM_ID=
SAP_API_URL=

# Optional: use Lago-compatible SMTP environment settings instead of the app form.
# Reminders remain drafts until a person approves and sends each one.
LAGO_SMTP_ADDRESS=
LAGO_SMTP_PORT=587
LAGO_SMTP_USERNAME=
LAGO_SMTP_PASSWORD=
LAGO_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_SSL=false

MAX_TOUCHES_PER_WEEK=2
DEDUP_WINDOW_HOURS=48
MATERIALITY_CENTS=1000000
TERMINAL_TOUCHES=3
RETRY_AUTO_CAP_CENTS=200000

